# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn/
/coverage
/.nyc_output
*.lcov

# ---------- 构建产物 ----------
/out
/dist
/dist-electron
/release
/*-unpacked
*.tsbuildinfo
*.blockmap

# 注意：build/ 是 electron-builder 的 buildResources 目录，
# 里面的 icon.png / icon.ico 必须入库，不要整个忽略。
/build/*.iconset
/build/*.dmg
/build/*.app

# 注意：package-lock.json 必须入库，保证换机器装出来的依赖一致。

# ---------- 缓存 ----------
/.vite
/.cache
/.turbo
/.parcel-cache
/.eslintcache
/.stylelintcache
/node_modules/.cache

# ---------- 日志与崩溃转储 ----------
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/_cacache
*.dmp
hs_err_pid*
report.*.json

# ---------- 环境变量 ----------
.env
.env.*
!.env.example

# ---------- 打包产物（release/ 之外的散落文件）----------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------- 编辑器与 IDE ----------
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
/.idea
/.history
/.fleet
*.code-workspace
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# ---------- 本地启动项（路径与本机绑定，用 --shortcut 重新生成）----------
*.lnk
*.desktop

# ---------- 本地工具状态 ----------
.commandcode/

# ---------- 杂项 ----------
*.local
/tmp
/temp
